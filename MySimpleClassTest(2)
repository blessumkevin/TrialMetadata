/**
 * @description Unit tests for MySimpleClass. Every test method runs its
 * assertions inside System.runAs using a test user with a unique username.
 */
@isTest
private class MySimpleClassTest {

    /**
     * @description Builds a username that is unique across all Salesforce orgs.
     * Combines a prefix, the current timestamp, a random number, and the org Id,
     * so repeated runs and other orgs never collide.
     * @param prefix The leading text for the username, for example 'testuser'.
     * @return A unique username formatted like an email address.
     */
    private static String buildUniqueUsername(String prefix) {
        String uniqueKey = String.valueOf(DateTime.now().getTime())
            + String.valueOf(Math.abs(Crypto.getRandomInteger()));
        return prefix + '.' + uniqueKey + '@' + UserInfo.getOrganizationId() + '.test.com';
    }

    /**
     * @description Creates and inserts a test user with a unique username.
     * The user shares the profile of the current user.
     * @param prefix The leading text for the username, for example 'testuser'.
     * @return The inserted User record.
     */
    private static User createTestUser(String prefix) {
        User testUser = new User(
            FirstName = 'Test',
            LastName = 'User',
            Email = 'testuser@example.com',
            Username = buildUniqueUsername(prefix),
            Alias = 'tuser',
            TimeZoneSidKey = 'America/Los_Angeles',
            LocaleSidKey = 'en_US',
            EmailEncodingKey = 'UTF-8',
            ProfileId = UserInfo.getProfileId(),
            LanguageLocaleKey = 'en_US'
        );
        insert testUser;
        return testUser;
    }

    @isTest static void testGreetingMorningAndEvening() {
        User testUser = createTestUser('greeting');

        System.runAs(testUser) {
            System.assertEquals('Good morning', MySimpleClass.getGreeting(true), 'Expected morning greeting');
            System.assertEquals('Good evening', MySimpleClass.getGreeting(false), 'Expected evening greeting');
        }
    }

    @isTest static void testFindUsersByUsername() {
        User testUser = createTestUser('finduser');

        System.runAs(testUser) {
            List<User> foundUsers = MySimpleClass.findUsersByUsername(testUser.Username);
            System.assertEquals(1, foundUsers.size(), 'Should find exactly one user');
            System.assertEquals(testUser.Id, foundUsers[0].Id, 'Returned user ID should match inserted user');
        }
    }
}
